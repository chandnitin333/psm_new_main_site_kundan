# API Configuration
# Use the PC's LAN IP so the backend is reachable from a phone on the same Wi-Fi.
# (For PC-only work you can switch this back to http://localhost:5000/api)
VITE_API_BASE_URL=http://localhost:5000/api
# VITE_API_BASE_URL=http://192.168.1.33:5000/api
VITE_API_TIMEOUT=30000

# App Configuration
VITE_APP_NAME=PSM Main Site
VITE_APP_ENV=development

# QR scan testing: phone par scan ke liye QR me ye base URL aayega.
# Revert: is line ko hata do (ya khali kar do) -> QR window.location.origin use karega.
# VITE_PUBLIC_BASE_URL=http://192.168.1.33:5173
